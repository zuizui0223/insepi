{
  "schema": "interaction-sensing-v11-contradiction-development-protocol-v1",
  "status": "pre-result-frozen",
  "scientific_question": "Does preserving epistemically distinct biological-evidence and observability-risk channels, together with protected random audit, localise hidden failure mechanisms and reduce wrong repairs better than single-channel or early scalar-fusion development?",
  "scientific_object": "development strategy, not a new allocation score",
  "non_interference": {
    "v6_weights_changed": false,
    "v7_result_changed_or_rescued": false,
    "v10_protocol_or_pixels_changed": false,
    "v8_or_v9_retuned": false,
    "direct_disagreement_allocation_restored": false
  },
  "prior_result_boundary": {
    "v7_locked_result_is_historical_input_only": true,
    "v7_gate": "FAIL",
    "v7_claim_level": "C",
    "v7_result_may_not_change_v11_grid_or_claim_rules": true
  },
  "truth_axes": {
    "biological_event": [0, 1],
    "observation_disturbance": [0, 1],
    "factorial_states": ["clean_absence", "clean_event", "nuisance_only", "event_plus_nuisance"]
  },
  "diagnostic_states": {
    "threshold": 0.5,
    "states": ["evidence_high_observability_low", "evidence_low_observability_high", "both_high", "both_low"],
    "interpretation": {
      "evidence_high_observability_low": "comparatively observable event evidence",
      "evidence_low_observability_high": "observation-failure or missed-event-risk hypothesis",
      "both_high": "event evidence under confounding",
      "both_low": "quiet state or shared blind spot; protected audit is required to separate them"
    },
    "disagreement_is_truth": false,
    "disagreement_is_direct_acquisition_score": false
  },
  "failure_classes": ["event_module", "observability_module", "shared_representation", "no_fault"],
  "mechanisms": {
    "development": {
      "event_module": "event_contrast_loss",
      "observability_module": "glare_risk_blind",
      "shared_representation": "occlusion_shared_blind",
      "no_fault": "clean_control_dev"
    },
    "heldout": {
      "event_module": "event_scale_shift",
      "observability_module": "shadow_risk_blind",
      "shared_representation": "blur_shared_blind",
      "no_fault": "clean_control_test"
    }
  },
  "intensity_tiers": [0.35, 0.65, 0.95],
  "fixed_probe_panel": [
    {"name": "clean_absence", "event": 0, "disturbance": 0, "truth_known_by_design": true},
    {"name": "clean_event", "event": 1, "disturbance": 0, "truth_known_by_design": true},
    {"name": "nuisance_only", "event": 0, "disturbance": 1, "truth_known_by_design": true},
    {"name": "event_plus_nuisance", "event": 1, "disturbance": 1, "truth_known_by_design": true},
    {"name": "blind_natural_a", "event": "seeded", "disturbance": "seeded", "truth_known_by_design": false},
    {"name": "blind_natural_b", "event": "seeded", "disturbance": "seeded", "truth_known_by_design": false}
  ],
  "protected_audit": {
    "applies_only_to_blind_natural_probes": true,
    "fraction": 0.5,
    "assignment": "SHA256(domain|split|mechanism|intensity|replicate|probe), first byte < 128",
    "domain": "interaction-sensing-v11-protected-audit-v1",
    "same_audit_assignments_for_all_strategies": true,
    "spillover_into_targeted_diagnosis": false
  },
  "simulation": {
    "development_replicates_per_mechanism_intensity": 300,
    "heldout_replicates_per_mechanism_intensity": 300,
    "shared_residual_correlation": 0.35,
    "observer_noise_sd": 0.08,
    "seed_domain": "interaction-sensing-v11-development-world-v1",
    "no_post_result_tuning": true
  },
  "strategies": {
    "event_only": {"visible_channels": ["evidence"], "audit_truth": ["event_if_protected"], "early_fusion": false},
    "observability_only": {"visible_channels": ["observability"], "audit_truth": ["disturbance_if_protected"], "early_fusion": false},
    "early_scalar_fusion": {"visible_channels": ["0.5*evidence + 0.5*observability"], "audit_truth": ["max(event,disturbance)_if_protected"], "early_fusion": true},
    "contradiction_guided": {"visible_channels": ["evidence", "observability", "diagnostic_state"], "audit_truth": ["event_if_protected", "disturbance_if_protected", "both_low_shared_miss_indicator"], "early_fusion": false}
  },
  "classifier": {
    "type": "nearest-centroid",
    "training_split": "development mechanism subtype only",
    "test_split": "heldout mechanism subtype only",
    "distance": "squared Euclidean after feature-wise z scaling learned on development split",
    "tie_break": "lexicographic failure-class name",
    "no_hyperparameter_search": true
  },
  "primary_metrics": ["heldout_failure_localisation_accuracy", "wrong_module_intervention_rate", "shared_blindspot_discovery_rate", "no_fault_false_intervention_rate", "experiments_to_stable_falsification", "heldout_repair_positive_transfer_rate", "heldout_repair_relative_loss_reduction"],
  "experiments_to_stable_falsification": {
    "definition": "smallest prefix length k in 1..6 for which the diagnosis is correct and remains correct for every longer prefix; use 7 if no stable correct diagnosis occurs",
    "same_probe_order_for_all_strategies": true
  },
  "repair_test": {
    "evaluation_target": "heldout mechanism subtype",
    "repair_actions": ["event_module", "observability_module", "shared_representation", "no_fault"],
    "repair_is_selected_from_predicted_failure_class": true,
    "loss": "mean of squared evidence error to event truth and squared observability error to disturbance truth across the six fixed probes",
    "positive_transfer": "post-repair heldout loss < pre-repair heldout loss",
    "wrong_repairs_are_not_silently_clipped_to_help": true
  },
  "claim_ceiling": {
    "A": {
      "requirements": ["contradiction-guided heldout localisation accuracy >= best comparator + 0.10", "shared-blindspot discovery rate >= 0.80", "wrong-module intervention rate <= 0.20", "heldout repair positive-transfer rate >= 0.75", "no-fault false-intervention rate <= 0.20"],
      "allowed_claim": "Preserving distinct observer hypotheses plus protected audit materially improves failure localisation and transferable repair selection over the tested single-channel and early-fusion development strategies."
    },
    "B": {
      "requirements": ["contradiction-guided heldout localisation accuracy >= best comparator", "shared-blindspot discovery rate >= 0.65", "heldout repair positive-transfer rate >= 0.60"],
      "allowed_claim": "Contradiction-guided development is competitive overall and improves diagnosis of shared blind spots, but the advantage is conditional."
    },
    "C": {
      "requirements": ["neither A, B nor D"],
      "allowed_claim": "Development value is mixed or mechanism-specific; report diagnostic boundaries without a general superiority claim."
    },
    "D": {
      "requirements": ["contradiction-guided heldout localisation accuracy < best comparator - 0.05 OR shared-blindspot discovery rate < 0.50"],
      "allowed_claim": "The tested contradiction-guided development protocol does not improve reliable failure localisation over simpler development strategies."
    }
  },
  "forbidden_claims": ["statistical independence of observer errors", "disagreement is ground truth", "disagreement should directly allocate sensing budget", "universal optimality of any PolliPi/InsePi quota", "field biological-event accuracy", "V11 rescues or reinterprets V7", "V11 substitutes for a physical held-out V12 validation"]
}
